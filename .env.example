# Copy to .env and fill in. NEVER commit .env.
VECTOR_STORE=memory
EMBEDDING_PROVIDER=hash

PINECONE_API_KEY=
PINECONE_INDEX=ops-assistant
PINECONE_NAMESPACE=tenant-demo
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=multilingual-e5-large

MIN_SCORE=-1
CHUNK_WORDS=180
CHUNK_OVERLAP_WORDS=30

API_KEYS_JSON=
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=
SUPPORT_ROUTE=the IT/Operations Service Desk (servicedesk@example.com)
INGEST_SAMPLES_ON_STARTUP=false